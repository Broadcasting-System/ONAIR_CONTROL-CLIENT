{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ONAIR",
  "version": "0.1.0",
  "identifier": "kr.bssm.onair",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "BSSM 방송부",
    "category": "Utility",
    "shortDescription": "ONAIR 학교 방송 원격 제어",
    "longDescription": "ONAIR 서버의 컨트롤 화면을 여는 데스크탑 앱. 접속 키는 OS 키체인에만 저장됩니다.",
    "copyright": "© BSSM 방송부",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["ko-KR"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["onair"]
      }
    }
  }
}
